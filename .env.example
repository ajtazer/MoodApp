# Copy this file to .env for local development. Never commit .env.

# Local development only. Leave unset (or False) in production.
DEBUG_FLAG=True

# Required in production. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Optional, comma-separated. Default: .vercel.app,localhost,127.0.0.1
# DJANGO_ALLOWED_HOSTS=

# Production database (Vercel Postgres). Leave unset locally to use db.sqlite3.
# POSTGRES_DATABASE=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=

# Vercel Blob token for post image uploads.
# BLOB_READ_WRITE_TOKEN=
